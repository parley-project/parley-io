<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!-- License, developer, SCM, URL, Java level and the Maven Central release profile
	     all come from parley-parent. -->
	<parent>
		<groupId>us.bringardner.parley</groupId>
		<artifactId>parley-parent</artifactId>
		<version>1.0.0</version>
		<relativePath>../parley-parent/pom.xml</relativePath>
	</parent>

	<artifactId>parley-io</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<name>Parley IO</name>
	<description>
		Classes for reading and writing lines of text with an explicit end of line (EOL).
		The EOL varies from one OS to another, but an Internet protocol is NOT system
		dependent, so this package makes it easy to clearly define and use the EOL you need.
		Formerly us.bringardner:bjl_io.
	</description>
	<inceptionYear>1998</inceptionYear>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<!-- Written to the jar manifest as Automatic-Module-Name (was us.bringardner.io) -->
		<parley.moduleName>us.bringardner.parley.io</parley.moduleName>
		<junit.version>5.11.4</junit.version>
		<jacoco.version>0.8.13</jacoco.version>
		<!-- 'mvn verify' fails if coverage of the whole project drops below these ratios -->
		<jacoco.minLineCoverage>0.90</jacoco.minLineCoverage>
		<jacoco.minBranchCoverage>0.90</jacoco.minBranchCoverage>
	</properties>

	<build>
		<plugins>
			<!-- Plugins listed only in pluginManagement are NOT executed, so the source jar is declared here. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
			</plugin>
			<!-- JaCoCo code coverage: 'mvn verify' writes the report to target/site/jacoco/index.html -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
			</plugin>
		</plugins>

		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>3.13.0</version>
					<configuration>
						<!-- release (not source/target) also checks that only Java 11 APIs are used -->
						<release>${maven.compiler.release}</release>
					</configuration>
				</plugin>

				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-source-plugin</artifactId>
					<version>3.3.1</version>
					<executions>
						<execution>
							<id>attach-sources</id>
							<goals>
								<goal>jar-no-fork</goal>
							</goals>
							<!-- package (not deploy) so the source jar is attached BEFORE the deploy plugin runs -->
							<phase>package</phase>
						</execution>
					</executions>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-deploy-plugin</artifactId>
					<version>3.1.4</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>3.5.2</version>
				</plugin>

				<plugin>
					<groupId>org.jacoco</groupId>
					<artifactId>jacoco-maven-plugin</artifactId>
					<version>${jacoco.version}</version>
					<executions>
						<!-- Sets the surefire argLine so the tests run with the JaCoCo agent.
						     If you ever set argLine yourself, use "@{argLine} your-flags" or coverage will be 0%. -->
						<execution>
							<id>prepare-agent</id>
							<goals>
								<goal>prepare-agent</goal>
							</goals>
						</execution>
						<execution>
							<id>report</id>
							<phase>verify</phase>
							<goals>
								<goal>report</goal>
							</goals>
						</execution>
						<execution>
							<id>check</id>
							<phase>verify</phase>
							<goals>
								<goal>check</goal>
							</goals>
							<configuration>
								<rules>
									<rule>
										<element>BUNDLE</element>
										<limits>
											<limit>
												<counter>LINE</counter>
												<value>COVEREDRATIO</value>
												<minimum>${jacoco.minLineCoverage}</minimum>
											</limit>
											<limit>
												<counter>BRANCH</counter>
												<value>COVEREDRATIO</value>
												<minimum>${jacoco.minBranchCoverage}</minimum>
											</limit>
										</limits>
									</rule>
								</rules>
							</configuration>
						</execution>
					</executions>
				</plugin>
			</plugins>
		</pluginManagement>

	</build>

	<distributionManagement>
		<repository>
			<id>github</id>
			<name>tony-bringardner</name>
			<url>https://maven.pkg.github.com/tony-bringardner/parley-io</url>
		</repository>

	</distributionManagement>



	<dependencies>
		<!-- parley-core is only used by the tests (BaseThread), so it is not passed on to projects that use parley-io. -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-core</artifactId>
			<version>1.0.0</version>
			<scope>test</scope>
		</dependency>
		<!-- junit-jupiter includes the API (to compile tests) and the engine (to run them) -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
