<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!-- License, developer, SCM, URL, Java level and the Maven Central release profile
	     all come from parley-parent. -->
	<parent>
		<groupId>us.bringardner.parley</groupId>
		<artifactId>parley-parent</artifactId>
		<version>1.0.0</version>
		<relativePath>../parley-parent/pom.xml</relativePath>
	</parent>

	<artifactId>parley-io</artifactId>
	<version>1.0.0</version>
	<name>Parley IO</name>
	<description>
		Classes for reading and writing lines of text with an explicit end of line (EOL).
		The EOL varies from one OS to another, but an Internet protocol is NOT system
		dependent, so this package makes it easy to clearly define and use the EOL you need.
		Formerly us.bringardner:bjl_io.
	</description>
	<inceptionYear>1998</inceptionYear>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<!-- Written to the jar manifest as Automatic-Module-Name (was us.bringardner.io) -->
		<parley.moduleName>us.bringardner.parley.io</parley.moduleName>
		<junit.version>5.11.4</junit.version>
		<!-- 'mvn verify' fails if coverage of the whole project drops below these ratios -->
		<jacoco.minLineCoverage>0.90</jacoco.minLineCoverage>
		<jacoco.minBranchCoverage>0.90</jacoco.minBranchCoverage>
	</properties>

	<build>
		<plugins>
			<!-- Sources jar attached at package (not deploy) so it exists BEFORE the deploy plugin runs.
			     The parent's release profile adds the same execution for Maven Central. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<executions>
					<execution>
						<id>attach-sources</id>
						<phase>package</phase>
						<goals>
							<goal>jar-no-fork</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- JaCoCo code coverage: 'mvn verify' writes the report to target/site/jacoco/index.html.
			     If you ever set argLine yourself, use "@{argLine} your-flags" or coverage will be 0%. -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<execution>
						<id>check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>${jacoco.minLineCoverage}</minimum>
										</limit>
										<limit>
											<counter>BRANCH</counter>
											<value>COVEREDRATIO</value>
											<minimum>${jacoco.minBranchCoverage}</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<dependencies>
		<!-- parley-core is only used by the tests (BaseThread), so it is not passed on to projects that use parley-io. -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-core</artifactId>
			<version>1.0.0</version>
			<scope>test</scope>
		</dependency>
		<!-- junit-jupiter includes the API (to compile tests) and the engine (to run them) -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
